{
  "name": "repos",
  "version": "1.0.0",
  "main": "main.js",
  "types": "main.ts",
  "license": "MPL-2.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "format": "prettier --write '**/*.{ts,js,md,yml}'",
    "get": "cdktn get",
    "build": "pnpm run get && tsc",
    "synth": "cdktn synth",
    "compile": "tsc --pretty",
    "watch": "tsc -w",
    "test": "echo ok",
    "lint": "npx lint-staged",
    "upgrade": "npm i cdktn@latest cdktn-cli@latest",
    "upgrade:next": "npm i cdktn@next cdktn-cli@next",
    "output": "cd cdktf.out && terraform output -json -state ../terraform.tfstate",
    "repos": "pnpm --silent run output | jq  'with_entries(select(.key|match(\"providerRepos\";\"i\")))[] | .value'",
    "repos:secrets:encrypt": "sops -e cdktf.out/stacks/repos/terraform.tfvars > secrets-encrypted/repos-terraform.tfvars",
    "repos:secrets:decrypt": "sops -d secrets-encrypted/repos-terraform.tfvars > cdktf.out/stacks/repos/terraform.tfvars",
    "official:secrets:encrypt": "sops -e cdktf.out/stacks/repos-official-new/terraform.tfvars > secrets-encrypted/official-terraform.tfvars",
    "official:secrets:decrypt": "sops -d secrets-encrypted/official-terraform.tfvars > cdktf.out/stacks/repos-official-new/terraform.tfvars"
  },
  "engines": {
    "node": ">= 24"
  },
  "dependencies": {
    "@cdktn/provider-github": "^18.0.0",
    "@cdktn/provider-aws": "^25.0.0",
    "@cdktn/provider-time": "14.0.0",
    "@cdktn/provider-archive": "^14.0.0",
    "@cdktn/provider-cloudinit": "^14.0.0",
    "@cdktn/provider-docker": "^16.0.0",
    "@cdktn/provider-tls": "^14.0.0",
    "cdktn": "^0.24.0",
    "cdktn-cli": "^0.24.0",
    "change-case": "~4.1.2",
    "constructs": ">=10.6.0 <10.8.0",
    "terraconstructs": "0.2.15",
    "@aws-cdk/region-info": "*",
    "@aws-cdk/cloud-assembly-schema": "^49.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "lint-staged": "^15.5.2",
    "prettier": "^3",
    "tsx": "^4.0.0",
    "typescript": "~5.8.0"
  },
  "lint-staged": {
    "*.{md,yml}": "prettier --write",
    "**/*.{ts,js}": [
      "eslint",
      "prettier --write"
    ]
  },
  "terraform": {
    "version": "1.13.3"
  }
}
